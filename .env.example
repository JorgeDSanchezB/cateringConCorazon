# ─── Desarrollo local (sandbox / self-hosted) ───
# SQLite embebido. Ruta absoluta del sandbox o relativa al directorio prisma/
# (p. ej. file:../db/custom.db) en un checkout propio.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Secreto de firma de sesiones (32+ caracteres aleatorios).
# En desarrollo es opcional (hay fallback estable con warning); en Vercel es
# OBLIGATORIA y el arranque falla sin ella. Genera una con:
#   openssl rand -hex 32
# AUTH_SECRET=

# ─── Producción: Vercel + Neon (ver docs/deploy-vercel-neon.md) ───
# En Vercel configura (dashboard → Settings → Environment Variables):
#
# DATABASE_URL       Cadena POOLED de Neon (con -pooler- y sslmode=require):
#                    postgresql://usuario:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# AUTH_SECRET        Secreto de sesiones (openssl rand -hex 32).
# BLOB_READ_WRITE_TOKEN  Token del store de Vercel Blob (para que las subidas
#                    de imágenes funcionen en producción; sin él, subir medios
#                    falla porque el filesystem de Vercel es de solo lectura).

# Cadena DIRECTA (sin -pooler-) para los scripts locales de despliegue a Neon:
#   NEON_DATABASE_URL=postgresql://usuario:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Uso: NEON_DATABASE_URL="..." bun run db:deploy-neon   (push + migración de datos)
# o    NEON_DATABASE_URL="..." bun run db:seed-neon     (datos demo idempotentes)

# ─── Opcionales técnicas (los defaults están en src/lib/config.ts) ───
# MAX_PAGE_LIMIT=50
# DEFAULT_PAGE_LIMIT=24
# LOGIN_MAX_PER_MINUTE=10
# ORDER_MAX_PER_MINUTE=6
# DISCOUNT_MAX_PER_MINUTE=20
# AI_DRAFT_MAX_PER_MINUTE=6
# UPLOAD_MAX_BYTES=5242880
# SESSION_TTL_HOURS=12
# BCRYPT_ROUNDS=12
